@echo off
chcp 936 >nul
title bilimusic 安装程序
setlocal enabledelayedexpansion
set "DEF=%LOCALAPPDATA%\Programs\bilimusic"

echo.
echo   ================================================
echo      bilimusic 桌面版（C++） · 安装程序
echo   ================================================
echo.
echo   默认安装位置：
echo     %DEF%
echo.
set "TARGET="
set /p "TARGET=   安装目录（回车用默认）："
if "%TARGET%"=="" set "TARGET=%DEF%"
set "TARGET=%TARGET:"=%"
for /f "tokens=* delims= " %%a in ("%TARGET%") do set "TARGET=%%a"
:trimtail
if not "%TARGET%"=="" if "%TARGET:~-1%"==" " set "TARGET=%TARGET:~0,-1%" & goto trimtail
if "%TARGET%"=="" set "TARGET=%DEF%"
echo.
echo   安装到：  %TARGET%
if not exist "%TARGET%" mkdir "%TARGET%"

rem 先结束正在运行的旧版本，否则 exe 被占用复制失败
powershell -NoProfile -Command "Get-Process bilimusic -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue" >nul 2>&1

rem 整包复制（含内置 VLC 的 vlc\ 目录）
xcopy /E /Y /I /Q "%~dp0*" "%TARGET%\" >nul

rem 桌面 + 开始菜单快捷方式（工作目录必须是安装目录）
powershell -NoProfile -Command "$ws=New-Object -ComObject WScript.Shell; foreach($d in @([Environment]::GetFolderPath('Desktop'),[Environment]::GetFolderPath('Programs'))){$l=$ws.CreateShortcut((Join-Path $d 'bilimusic.lnk')); $l.TargetPath='%TARGET%\bilimusic.exe'; $l.WorkingDirectory='%TARGET%'; $l.IconLocation='%TARGET%\bilimusic.ico'; $l.Description='bilimusic'; $l.Save()}"

rem 注册「应用和功能」卸载项（HKCU，无需管理员）
set "UNKEY=HKCU\Software\Microsoft\Windows\CurrentVersion\Uninstall\bilimusic"
reg add "%UNKEY%" /v DisplayName     /t REG_SZ    /d "bilimusic" /f >nul
reg add "%UNKEY%" /v DisplayVersion  /t REG_SZ    /d "1.0.0" /f >nul
reg add "%UNKEY%" /v Publisher       /t REG_SZ    /d "amns56780" /f >nul
reg add "%UNKEY%" /v DisplayIcon     /t REG_SZ    /d "%TARGET%\bilimusic.ico" /f >nul
reg add "%UNKEY%" /v InstallLocation /t REG_SZ    /d "%TARGET%" /f >nul
reg add "%UNKEY%" /v UninstallString /t REG_SZ    /d "\"%TARGET%\uninstall.bat\"" /f >nul
reg add "%UNKEY%" /v NoModify        /t REG_DWORD /d 1 /f >nul
reg add "%UNKEY%" /v NoRepair        /t REG_DWORD /d 1 /f >nul

echo.
echo   安装完成：
echo     程序目录  %TARGET%
echo     启动方式  桌面 / 开始菜单的 bilimusic，或双击安装目录里的 bilimusic.exe
echo     播放内核  VLC 已内置（vlc 目录），无需另外安装 VLC
echo     歌单数据  %USERPROFILE%\.bilimusic（与 Java 版共用）
echo.
choice /c YN /n /m "   现在启动 bilimusic？[Y/N] "
if errorlevel 2 goto :done
start "" "%TARGET%\bilimusic.exe"
:done
echo.
echo   安装程序结束，窗口 3 秒后自动关闭。
timeout /t 3 >nul
